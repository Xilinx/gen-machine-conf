menu "DT Settings"
config SUBSYSTEM_DT_WORKSPACE
	string "Device-tree workspace"
	help
	  Provide the location to use as Device-tree workspace location.

config SUBSYSTEM_DT_DOMAIN_ACCESS
	bool "Enable Domain Access"
	default n
	depends on SUBSYSTEM_SDT_FLOW
	help
	  Enable this option to use the domain_access assist to generate domain-specific
	  DTS files from the specified YAML files specified in the
	  YOCTO_MC_DOMAIN_FILEPATH configuration

config SUBSYSTEM_DT_INCLUDE_INFRASTRUCTURE
	string "Infrastructure categories for domain device inventory"
	default "all"
	depends on SUBSYSTEM_DT_DOMAIN_ACCESS
	help
	  Infrastructure categories passed to lopper sdt_devices through
	  --include-infrastructure. Use all (the default) or a comma-separated
	  list, such as protection,interconnect,slcr. An empty value uses all.
	  Use sdt_devices --list-infrastructure to list supported categories.
	  Domain wildcards select from this inventory. This option does not
	  bypass device discovery requirements or include clocks separately.

endmenu

if !SUBSYSTEM_ARCH_MICROBLAZE-V
menu "FPGA Manager"
config SUBSYSTEM_FPGA_MANAGER
        bool "Fpga Manager"
        help
	 Select this option to provides an interface to the Linux for configuring the programmable logic(PL).

if SUBSYSTEM_FPGA_MANAGER && SUBSYSTEM_SDT_FLOW
choice
	prompt "PL Device-Tree Overlay Type"

config SUBSYSTEM_PL_DT_OVERLAY_FULL
	bool "full"

config SUBSYSTEM_PL_DT_OVERLAY_DFX
	bool "dfx"

endchoice

config SUBSYSTEM_PL_INPUT_DTSI
	string "PL overlay input dtsi"
	default ""
	help
	  Provide input device tree source (.dtsi) file(s) to merge with the default
	  pl.dtso generated by the xlnx_overlay_pl_dt lopper assist.
	  The provided dtsi changes will be merged into the generated PL overlay.
	  Multiple files can be specified separated by spaces.
	  Leave empty to use only the default pl.dtso.

endif
endmenu
endif
