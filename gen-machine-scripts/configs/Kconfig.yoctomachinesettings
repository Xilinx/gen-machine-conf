config YOCTO_MACHINE_NAME
       string "Yocto Machine Name"
       default "versal-net-generic" if SUBSYSTEM_VARIANT_VERSALNET
       default "versal-generic" if SYSTEM_VERSAL
       default "versal-2ve-2vm-generic" if SYSTEM_VERSAL-2VE-2VM
       default "versal-2vp-generic" if SYSTEM_VERSAL-2VP
       default "zynqmp-generic" if SYSTEM_ZYNQMP
       default "zynq-generic" if SUBSYSTEM_ARCH_ARM
       default "microblaze-v-generic" if SUBSYSTEM_ARCH_MICROBLAZE-V
       help
         You can specify MACHINE_NAME using this variable.
	 Auto append the deviceId to Machine Name if this matches with INCLUDE_MACHINE_NAME

config YOCTO_INCLUDE_MACHINE_NAME
	string "Yocto Include Machine name"
	help
	  Specify MACHINE_NAME which will need to be include into the YOCTO_MACHINE file

config YOCTO_ADD_OVERRIDES
	string "Yocto Additional Overrides"
	default ""
	help
	  Specify additional overrides to the generated machine conf file
	  Specify multiple overrides with ':' separator

if SUBSYSTEM_SDT_FLOW

if !SUBSYSTEM_ARCH_MICROBLAZE-V
config YOCTO_MACHINE_FEATURE_EFI
        bool "Enable EFI Machine Feature"
        default y if SUBSYSTEM_ARCH_AARCH64
        help
          Enable this option to use the EFI Boot Manager, which manages and selects bootable
          operating systems and EFI applications stored in firmware. It determines the boot order,
          supports multiple operating systems, and loads the selected bootloader from the EFI
          System Partition, providing flexible and reliable UEFI-based system startup.
endif

if SUBSYSTEM_VARIANT_ZYNQMPEV
menuconfig YOCTO_MACHINE_HWCODECS
        bool "Hardware codecs (MACHINE_HWCODECS)"
        default y
        help
          Enable and select the hardware codec engines assigned to
          MACHINE_HWCODECS in the generated machine conf.

if YOCTO_MACHINE_HWCODECS
config YOCTO_MACHINE_HWCODECS_ENGINE_LIBVCU-OMXIL
        bool "libvcu-omxil"
        depends on SUBSYSTEM_VARIANT_ZYNQMPEV
        default y
        help
          Use the libvcu-omxil OpenMAX IL hardware codec engine.

config YOCTO_MACHINE_HWCODECS_EXTRA
        string "Additional (user-defined) hardware codecs"
        default ""
        help
          Specify additional hardware codec entries to append to
          MACHINE_HWCODECS. Separate multiple values with spaces.
endif
endif

@@multiconfigmenustr@@

config YOCTO_MC_DOMAIN_FILEPATH
	string "Domain file Path"
	default ""
	help
	  Specify the domain file path to use in the generation of multiconfig files.

endif
